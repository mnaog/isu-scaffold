#!/usr/bin/env bash
set -euo pipefail

wrapper_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_dir=$(cd -- "${wrapper_dir}/../.." && pwd)
environment_file=${ISUCON_ENV_FILE:-${repo_dir}/.local/environment.env}
real_ssh=${ISUSCOPE_REAL_SSH:-/usr/bin/ssh}

test -x "${real_ssh}" || { echo "missing SSH command: ${real_ssh}" >&2; exit 1; }
test -f "${environment_file}" || { echo "missing environment file: ${environment_file}" >&2; exit 1; }
# shellcheck disable=SC1090
source "${environment_file}"

known_hosts_file=${SSH_KNOWN_HOSTS_FILE:-.local/known-hosts}
case "${known_hosts_file}" in
  /*) ;;
  *) known_hosts_file=${repo_dir}/${known_hosts_file} ;;
esac

exec "${real_ssh}" \
  -o StrictHostKeyChecking=accept-new \
  -o "UserKnownHostsFile=${known_hosts_file}" \
  "$@"
