{
  "description": "scripts/new-contest-repo.py が scaffold から大会用repoを作るときに除くもの。scaffold自身の開発で溜まった履歴・実験・別件の資料と、この複製の仕組み自身。ここに無いcommit済みのfileはすべて新しいrepoへ入る。keepは除外patternに当たっても残すfile。",
  "exclude": [
    "docs/agent-history/*",
    "isuscope-data/*",
    "docs/ai-compare/*",
    "scripts/ai-compare/*",
    "config/ai-compare/*",
    "tests/test_ai_compare.py",
    "docs/research/*",
    "docs/roles/*",
    "docs/official/lithosai-*",
    "config/new-repo.json",
    "config/phase0/*",
    "scripts/new-contest-repo.py",
    "tests/test_new_contest_repo.py"
  ],
  "keep": [
    "docs/agent-history/.gitkeep",
    "docs/agent-history/Readme.md",
    "isuscope-data/README.md"
  ],
  "practice_only": ["practice.md"],
  "readiness_template": "config/phase0/readiness.md"
}
