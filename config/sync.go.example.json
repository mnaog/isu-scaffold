{
  "source_node": "app1",
  "minimum_free_mb_after_deploy": 1024,
  "pre_deploy_command": "",
  "items": [
    {
      "name": "go-app",
      "type": "directory",
      "node_group": "application",
      "local": "webapp/go",
      "remote": "/home/isucon/webapp/go",
      "owner": "isucon",
      "owner_group": "isucon",
      "exclude": [
        "replace-with-binary-name",
        ".git"
      ]
    }
  ],
  "build_commands": [],
  "post_deploy_commands": [
    {
      "node_group": "application",
      "command": "sudo systemctl daemon-reload",
      "when": [
        "go-service"
      ]
    },
    {
      "node_group": "application",
      "command": "sudo systemctl restart replace-with-service-name",
      "when": [
        "go-app",
        "go-service",
        "app-env*"
      ]
    },
    {
      "node_group": "application",
      "command": "sudo systemctl is-active --quiet replace-with-service-name"
    }
  ],
  "rollback_commands": [
    {
      "node_group": "application",
      "command": "sudo systemctl daemon-reload",
      "when": [
        "go-service"
      ]
    },
    {
      "node_group": "application",
      "command": "sudo systemctl restart replace-with-service-name",
      "when": [
        "go-app",
        "go-service",
        "app-env*"
      ]
    },
    {
      "node_group": "application",
      "command": "sudo systemctl is-active --quiet replace-with-service-name"
    }
  ],
  "status_commands": [
    "systemctl is-active replace-with-service-name"
  ],
  "local_builds": [
    {
      "item": "go-app",
      "target": "linux/amd64",
      "binary": "replace-with-binary-name",
      "output": "replace-with-binary-name",
      "package": "."
    }
  ]
}
