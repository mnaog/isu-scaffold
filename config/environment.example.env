# `.local/environment.env`へコピーし、当日の接続方法に合わせます。
# aws-cloudformation: stack配下のEC2を自動検出
# static: STATIC_NODES_FILEに記述したnodeを使用
DISCOVERY_PROVIDER=aws-cloudformation

AWS_PROFILE=
AWS_REGION=ap-northeast-1
CLOUDFORMATION_STACK=

# CloudFormation stack配下のEC2をName tagで分類します。
DISCOVERY_APP_NAME_REGEX='(app|web)[0-9]*$'
DISCOVERY_BENCH_NAME_REGEX='(bench|benchmark)[0-9]*$'

SSH_USER=ubuntu
SSH_IDENTITY_FILE=.local/operator-key
SSH_KNOWN_HOSTS_FILE=.local/known-hosts

# static providerではconfig/nodes.example.jsonをコピーして編集します。
STATIC_NODES_FILE=.local/nodes.json

# provider検出後にname一致でroles/user/groupを上書きする任意ファイルです。
NODE_OVERRIDES_FILE=.local/node-overrides.json

# eic: EC2 Instance Connectでoperator鍵を登録
# existing: 既に登録済みのSSH鍵をそのまま使用
SSH_BOOTSTRAP_METHOD=eic

# configure-draftで検出できるisuscope log path。未設定なら一般的なpathを使います。
ISUSCOPE_NGINX_ACCESS_LOG=/var/log/nginx/isuscope-access.log
ISUSCOPE_MYSQL_SLOW_LOG=/var/log/mysql/isuscope-slow.log

# cgroup v2から1秒ごとにCPU・memory・I/Oを追うsystemd unit。空ならcollectorは無効です。
# 例: ISUSCOPE_SERVICE_UNITS='nginx.service mysql.service isu.service'
ISUSCOPE_SERVICE_UNITS=
