{
  "source_node": "app1",
  "minimum_free_mb_after_deploy": 2048,
  "pre_deploy_command": "",
  "items": [
    {
      "name": "rust-app",
      "type": "directory",
      "node_group": "application",
      "local": "webapp/rust",
      "remote": "/home/isucon/webapp/rust",
      "owner": "isucon",
      "owner_group": "isucon"
    }
  ],
  "build_commands": [],
  "post_deploy_commands": [
    {
      "node_group": "application",
      "command": "sudo systemctl restart replace-with-service-name"
    },
    {
      "node_group": "application",
      "command": "sudo systemctl is-active --quiet replace-with-service-name"
    }
  ],
  "rollback_commands": [
    {
      "node_group": "application",
      "command": "sudo systemctl restart replace-with-service-name"
    },
    {
      "node_group": "application",
      "command": "sudo systemctl is-active --quiet replace-with-service-name"
    }
  ],
  "status_commands": [
    "systemctl is-active replace-with-service-name"
  ],
  "local_builds": [
    {
      "item": "rust-app",
      "dockerfile": "config/rust-builder/Dockerfile",
      "base_image": "rust:1.63.0-bullseye",
      "target": "x86_64-unknown-linux-gnu",
      "binary": "replace-with-binary-name"
    }
  ]
}
