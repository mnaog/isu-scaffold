# Phase 1で大会のベンチ起動方法へ合わせて編集し、Git管理します。tokenやcookieは.local/benchmark-secrets.envへ置きます。
# BENCHMARK_TRANSPORTをlocal（操作端末で実行）、ssh（BENCHMARK_NODEで実行）、http（公式APIで開始・poll）へ変更するまでphase1-checkは成功しません。
BENCHMARK_TRANSPORT=unconfigured
# sshのときのベンチnode。空なら、inventoryのbenchmark groupにnodeが1台だけあればそれを使います
# （discoverが付ける名前はproviderで違い、AWSではstack名を含むため、既定の名前を決め打ちしません）。
BENCHMARK_NODE=
# 信頼した大会公式のコマンドだけを記述します。shell commandとして実行されます。
# 例: BENCHMARK_COMMAND='cd /path/to/benchmark && ./bench'
#     BENCHMARK_PROBE_COMMAND='test -x /path/to/benchmark/bench'
# 別userで動かす場合は`sudo -n -u USER sh -c '... && exec ./bench'`とし、ベンチの終了コードをそのまま返します。
# `sudo -i`はlogin shellがcommandを再解釈するため、入れ子の`$?`や引用符が壊れます。独自のPASS/FAIL行を足さず、
# ベンチ自身が出す最終結果の行をregexで指定します。
BENCHMARK_COMMAND=''
BENCHMARK_PROBE_COMMAND=''
BENCHMARK_SAMPLE_FILE=config/benchmark-sample.log
# sampleの最終scoreと合否を人間が読んで記入します。--checkはregexが同じ値を取り出すことを確認します。
# 初回（まだ実出力を見ていない）は両方空のままでよく、そのrunは判定をpendingにして出力を残します。
# `python3 scripts/benchmark-sample.py <run>`でその出力の読み取りを確かめ、`--apply --score N --pass true|false`で
# sampleの書き出し・記入・contractの再seal・--check・`isuscope rescore <run>`まで済ませます。
BENCHMARK_SAMPLE_SCORE=''
BENCHMARK_SAMPLE_PASS=''
# scoreは最後に一致した行の最後の数値です。`RegisterScore`のようなタグや途中経過に一致しないよう、最終結果の行に限定します。
# 既定は、よくある形（JSONの"score"・"pass"、`score: 123`、`[SCORE] 123`、`passed: true`・`[PASSED]: false`、PASS・FAIL）です。
# 合否は大文字小文字を区別せずに読み、FAILに一致すればPASSより優先します。実出力に合わなければ、
# `python3 scripts/benchmark-sample.py <run>`で保存済みの出力に対する読み取りを見ながら直します。
BENCHMARK_SCORE_REGEX='("score"[[:space:]]*:[[:space:]]*[0-9]+|(^|[^A-Za-z])([Ss]core|SCORE)[^0-9A-Za-z]*[0-9]+|スコア[^0-9]*[0-9]+)'
BENCHMARK_PASS_REGEX='("pass(ed)?"[[:space:]]*:[[:space:]]*true|(^|[^A-Za-z])PASSED[]"]?[[:space:]]*:[[:space:]]*true|(^|[^A-Za-z])PASS([^A-Za-z]|$)|最終チェックが成功)'
BENCHMARK_FAIL_REGEX='("pass(ed)?"[[:space:]]*:[[:space:]]*false|(^|[^A-Za-z])PASSED[]"]?[[:space:]]*:[[:space:]]*false|(^|[^A-Za-z])FAIL([^A-Za-z]|$)|最終チェック.*(失敗|エラー)|不合格)'
BENCHMARK_TIMEOUT_SECONDS=900
# score・合否の判定から除く行。空なら`config/isuscope-policy.json`の`operator_line_pattern`を使います。
BENCHMARK_EXCLUDE_REGEX=''

# BENCHMARK_TRANSPORT=httpの場合に使用します。
# 例: BENCHMARK_HTTP_START_URL='https://portal.example/api/benchmarks'
#     BENCHMARK_HTTP_STATUS_URL='https://portal.example/api/benchmarks/{id}'
#     BENCHMARK_HTTP_PROBE_URL='https://portal.example/api/health'
BENCHMARK_HTTP_START_METHOD=POST
BENCHMARK_HTTP_START_URL=''
BENCHMARK_HTTP_STATUS_URL=''
BENCHMARK_HTTP_PROBE_METHOD=GET
BENCHMARK_HTTP_PROBE_URL=''
BENCHMARK_HTTP_HEADERS_FILE=.local/benchmark-headers.txt
BENCHMARK_HTTP_BODY_FILE=''
BENCHMARK_HTTP_ID_JQ='.id // .benchmark_id // empty'
BENCHMARK_HTTP_DONE_JQ='.status == "complete" or .status == "finished" or .done == true'
BENCHMARK_HTTP_SCORE_JQ='.score'
BENCHMARK_HTTP_PASS_JQ='.pass'
BENCHMARK_HTTP_MESSAGE_JQ='.message // ""'
BENCHMARK_HTTP_POLL_INTERVAL_SECONDS=2
BENCHMARK_HTTP_MAX_POLLS=600
BENCHMARK_HTTP_REQUEST_TIMEOUT_SECONDS=10
