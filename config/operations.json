{
  "interval_seconds": 900,
  "timeout_seconds": 600,
  "retry_max_seconds": 3600,
  "scenario": "docs/benchmark-scenario.md",
  "base_run": null,
  "isuscope": [
    "isuscope"
  ],
  "scouts": {
    "claude": {
      "label": "Claude Code",
      "model": "claude-opus-5-5",
      "argv": [
        "claude",
        "-p",
        "--model",
        "{model}",
        "--output-format",
        "json",
        "--session-id",
        "{session}",
        "--permission-prompts",
        "none"
      ],
      "output": "claude-json"
    },
    "codex": {
      "label": "Codex",
      "model": "gpt-6-astra",
      "argv": [
        "codex",
        "exec",
        "--json",
        "--model",
        "{model}",
        "--color",
        "never",
        "--output-last-message",
        "{output}",
        "-"
      ],
      "output": "codex-json"
    },
    "kimi": {
      "label": "Kimi Code + Kimi K3",
      "model": null,
      "argv": [
        "kimi"
      ],
      "output": "text",
      "unavailable": "Kimi Code CLIが見つからず、認証とKimi K3の正確なモデルID・非対話引数は未確認"
    },
    "opencode": {
      "label": "OpenCode + DeepSeek V4.1 Flash (Lithos Base)",
      "model": "lithosai/deepseek-ai/DeepSeek-V4.1-Flash",
      "argv": [
        "opencode",
        "run",
        "--model",
        "{model}",
        "--format",
        "json",
        "--title",
        "scout-{session}"
      ],
      "output": "opencode-json"
    }
  }
}
