{
  "history_dir": "docs/agent-history",
  "operator_line_pattern": "\\[ADMIN\\]",
  "prepare_command": [
    "scripts/benchmark-prepare.sh"
  ],
  "rescore_command": [
    ".isuscope/benchmark.sh",
    "--extract",
    "{benchmark_stdout}"
  ],
  "identity_command": [
    "scripts/benchmark-identity.py"
  ],
  "cleanup_command": [
    ".isuscope/benchmark.sh",
    "--cleanup"
  ],
  "idle_timeout_seconds": 300,
  "benchmark_parsers": [
    {
      "name": "contest-output",
      "command": [
        ".isuscope/parse-benchmark.sh",
        "{benchmark_stdout}"
      ],
      "timeout_seconds": 30
    }
  ]
}
