{
  "description": "Scouts (scripts/scout): each starts again wait_after_report_seconds after its last report was saved. timeout_seconds null lets a scout run until it reports. Copy the whole file to .local/scout.json to override it on one machine. A scout with manual: true is a person who posts with scripts/scout/main.py post (the daemon never runs it).",
  "wait_after_report_seconds": 240,
  "timeout_seconds": null,
  "retry_max_seconds": 3600,
  "scenario": "docs/benchmark-scenario.md",
  "base_run": null,
  "isuscope": [
    "isuscope"
  ],
  "scouts": {
    "human": {
      "label": "人間",
      "manual": true
    },
    "codex": {
      "label": "Codex (GPT-6.1-Sol high, Fast)",
      "model": "gpt-6.1-sol",
      "argv": [
        "codex",
        "exec",
        "--json",
        "--sandbox",
        "workspace-write",
        "--model",
        "{model}",
        "-c",
        "model_reasoning_effort=\"high\"",
        "-c",
        "service_tier=\"priority\"",
        "--color",
        "never",
        "--output-last-message",
        "{output}",
        "-"
      ],
      "output": "codex-json"
    },
    "codex-2": {
      "label": "Codex 2 (GPT-6.1-Sol high, Fast)",
      "model": "gpt-6.1-sol",
      "argv": [
        "codex",
        "exec",
        "--json",
        "--sandbox",
        "workspace-write",
        "--model",
        "{model}",
        "-c",
        "model_reasoning_effort=\"high\"",
        "-c",
        "service_tier=\"priority\"",
        "--color",
        "never",
        "--output-last-message",
        "{output}",
        "-"
      ],
      "output": "codex-json"
    }
  }
}
