{
  "description": "Scouts (scripts/scout): each starts again wait_after_report_seconds after its last report was saved. Copy the whole file to .local/scout.json to override it on one machine.",
  "wait_after_report_seconds": 480,
  "timeout_seconds": 600,
  "retry_max_seconds": 3600,
  "scenario": "docs/benchmark-scenario.md",
  "base_run": null,
  "isuscope": [
    "isuscope"
  ],
  "scouts": {
    "claude": {
      "label": "Claude Code",
      "model": "claude-opus-5-5",
      "argv": [
        "claude",
        "-p",
        "--model",
        "{model}",
        "--output-format",
        "json",
        "--session-id",
        "{session}",
        "--permission-prompts",
        "none"
      ],
      "output": "claude-json"
    },
    "codex": {
      "label": "Codex",
      "model": "gpt-6-astra",
      "argv": [
        "codex",
        "exec",
        "--json",
        "--model",
        "{model}",
        "--color",
        "never",
        "--output-last-message",
        "{output}",
        "-"
      ],
      "output": "codex-json"
    },
    "kimi": {
      "label": "Kimi Code + Kimi K3",
      "model": "kimi-code/k3",
      "argv": [
        "python3",
        "scripts/scout/stdin_as_arg.py",
        "kimi",
        "--model",
        "{model}",
        "--output-format",
        "stream-json",
        "--prompt"
      ],
      "output": "kimi-json"
    }
  }
}
